  "HTML5CodeInjection":"<GM_HTML5_PreHead>\r\n\r\n<link\r\n    href=\"html5game/zph_geoplay_map.css\"\r\n    rel=\"stylesheet\"\r\n/>\r\n\r\n<link\r\n    href=\"https://unpkg.com/maplibre-gl@5.12.0/dist/maplibre-gl.css\"\r\n    rel=\"stylesheet\"\r\n/>\r\n\r\n<script\r\n    src=\"https://unpkg.com/maplibre-gl@5.12.0/dist/maplibre-gl.js\">\r\n</script>\r\n\r\n</GM_HTML5_PreHead>\r\n\r\n\r\n<GM_HTML5_BodyStart>\r\n\r\n<div\r\n    id=\"geoplay-map\"\r\n    style=\"\r\n        position: fixed;\r\n        left: 0;\r\n        top: 0;\r\n        width: 100vw;\r\n        height: 100vh;\r\n        display: none;\r\n        z-index: 99999;\r\n        background: #111820;\r\n    \"\r\n></div>\r\n\r\n</GM_HTML5_BodyStart>\r\n\r\n\r\n<GM_HTML5_BodyEnd>\r\n\r\n<style>\r\n\r\nhtml,\r\nbody\r\n{\r\n    margin: 0;\r\n    padding: 0;\r\n\r\n    width: 100%;\r\n    height: 100%;\r\n\r\n    overflow: hidden;\r\n}\r\n\r\n\r\n#geoplay-map\r\n{\r\n    position: fixed;\r\n\r\n    left: 0;\r\n    top: 0;\r\n\r\n    width: 100vw;\r\n    height: 100vh;\r\n\r\n    display: none;\r\n\r\n    z-index: 99999;\r\n\r\n    background: #111820;\r\n}\r\n\r\n</style>\r\n\r\n</GM_HTML5_BodyEnd>",
